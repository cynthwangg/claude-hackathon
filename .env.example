# Fallback sender only. Replies normally come from the number she wrote to.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Must be the exact URL set in the Twilio sandbox, or the signature check refuses every message.
PUBLIC_WEBHOOK_URL=""
